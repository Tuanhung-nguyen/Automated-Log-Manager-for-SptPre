# ==========================================
# Cấu hình GitHub Actions Integration
# ==========================================
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repository_name

# ==========================================
# Cấu hình LLM Ollama Local
# ==========================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT=600
LLM_TEMPERATURE=0.0

# ==========================================
# Cấu hình Monitoring & Alerting (Phase 8)
# ==========================================
# Chu kỳ quét tự động (tính bằng giây).
# Ví dụ: 300 = 5 phút, 1800 = 30 phút, 3600 = 1 tiếng
POLL_INTERVAL_SECONDS=300

# ==========================================
# Cấu hình Databricks Integration (Phase 9)
# ==========================================
# Host workspace Databricks (ví dụ: https://dbc-xxxx.cloud.databricks.com)
DATABRICKS_HOST=https://your-databricks-workspace-url.cloud.databricks.com
# Personal Access Token tạo từ Databricks (User Settings -> Developer -> Access tokens)
DATABRICKS_TOKEN=dapi_your_databricks_personal_access_token

# ==========================================
# Cấu hình Telegram Notification
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id_from_userinfobot



